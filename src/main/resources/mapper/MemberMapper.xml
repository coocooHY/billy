<mapper namespace="com.javalab.board.repository.MemberMapper">

    <!-- 회원 등록 -->
    <insert id="insertMember" parameterType="com.javalab.board.vo.MemberVo">
        INSERT INTO person (
        person_id, email, password, name, birth, tel, file_name, file_path,
        address, location_id, grade_id, transCount, totalPoints
        ) VALUES (
        #{memberId, jdbcType=VARCHAR},
        #{email, jdbcType=VARCHAR},
        #{password, jdbcType=VARCHAR},
        #{name, jdbcType=VARCHAR},
        #{birth, jdbcType=DATE},
        #{tel, jdbcType=VARCHAR},
        #{fileName, jdbcType=VARCHAR},
        #{filePath, jdbcType=VARCHAR},
        #{address, jdbcType=VARCHAR},
        #{locationId, jdbcType=NUMERIC},
        #{gradeId, jdbcType=NUMERIC},
        #{transCount, jdbcType=NUMERIC},
        #{totalPoints, jdbcType=NUMERIC}
        )
    </insert>

    <!-- 사용자 역할 등록 -->
    <insert id="insertUserRole" parameterType="com.javalab.board.vo.UserRolesVo">
        INSERT INTO user_roles (user_id, user_type, role_id)
        VALUES (#{userId, jdbcType=VARCHAR}, #{userType, jdbcType=VARCHAR}, #{roleId, jdbcType=VARCHAR})
    </insert>

    <!-- 회원 아이디로 회원 정보 조회 -->
    <select id="findById" resultType="com.javalab.board.vo.MemberVo">
        SELECT * FROM person WHERE person_id = #{memberId, jdbcType=VARCHAR}
    </select>

    <!-- 소셜 로그인 정보로 회원 정보 조회 -->
    <select id="findMemberById" resultType="com.javalab.board.vo.MemberVo">
        SELECT * FROM person WHERE person_id = #{memberId, jdbcType=VARCHAR}
    </select>

